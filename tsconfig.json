{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,

    /*
     * Typing posture: the codebase is fully annotated (no implicit any;
     * explicit `any` only at documented dynamic boundaries like frontmatter).
     * strictNullChecks is the remaining strictness gap — the code was
     * migrated from untyped JS and relies pervasively on null/undefined
     * coalescing idioms; enable it module-by-module in a future pass.
     */
    "strict": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    /*
     * alwaysStrict stays off: esbuild would inject "use strict" into the
     * bundle, including inside the vendored SheetJS module — a runtime
     * semantics change the byte-identical migration deliberately avoids.
     */
    "alwaysStrict": false,
    "strictNullChecks": false
  },
  "include": ["src/**/*.ts"]
}
