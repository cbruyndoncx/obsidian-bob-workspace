        },
        {
          "label": "CAMPAIGNS",
          "entity": "campaign",
          "count": "all",
          "sub": "campaign records",
          "accent": "warn"
        },
        {
          "label": "ACTIVITIES",
          "entity": "activity",
          "count": "all",
          "sub": "activity records",
          "accent": "emerald"
        },
        {
          "label": "OPEN DEALS",
          "entity": "deal",
          "count": "open",
