    "crm.dashboard": {
      "title": "CRM Dashboard",
      "subtitle": "Lead, contact, campaign and activity overview",
      "stats": [
        {
          "label": "LEADS",
          "entity": "lead",
          "count": "all",
          "sub": "lead records",
          "accent": "sky"
        },
        {
          "label": "CONTACTS",
          "entity": "contact",
          "count": "all",
          "sub": "people records",
