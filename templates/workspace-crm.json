    "workspace.base-links": {
      "title": "Base Links",
      "subtitle": "Direct entry points into the workspace Bases",
      "layout": [
        [
          {
            "kind": "base-link",
            "entity": "deal",
            "base": {
              "view": "Pipeline"
            }
          },
          {
            "kind": "base-link",
            "entity": "contact",
            "base": {
              "view": "All Contacts"
            }
          }
        ]
      ]
    },
    "workspace.base-preview": {
      "title": "Base Preview",
      "subtitle": "Compact Base-backed previews for dashboard composition",
      "layout": [
        [
          {
            "kind": "base-embed",
            "entity": "deal",
            "base": {
              "view": "Pipeline"
            },
            "limit": 5,
            "titleFields": [
              "title",
              "deal_name"
            ],
            "metaFields": [
              "stage",
              "value",
              "closeBy"
            ]
          }
        ]
      ]
    },
    "workspace.report-note": {
      "title": "Report Note",
      "subtitle": "Narrative block for report or dashboard context",
      "layout": [
        [
          {
            "kind": "markdown",
            "title": "What to watch",
            "body": "## Current focus\n- Pipeline value is driven by open deals only.\n- Review aging deals before the end of the week.\n- Use the Base previews to jump into the underlying lists."
          }
        ]
      ]
    },
    "workspace.quick-actions": {
      "title": "Quick Actions",
      "subtitle": "Surface switches and record creation shortcuts",
      "layout": [
        [
          {
            "kind": "actions",
            "title": "Jump / Create",
            "actions": [
              {
                "label": "Open Pipeline",
                "surface": "crm.pipeline",
                "icon": "trending-up",
                "primary": true
              },
              {
                "label": "New Deal",
                "entityKey": "deal",
                "icon": "plus"
              },
              {
                "label": "Sales Report",
                "surface": "reports.sales",
                "icon": "bar-chart-3"
              }
            ]
          }
        ]
      ]
    },
    "workspace.report-filters": {
      "title": "Filtered Deals",
      "subtitle": "Selector-driven dashboard slices",
      "layout": [
        [
          {
            "kind": "selector",
            "key": "stage",
            "label": "Stage",
            "entity": "deal",
            "field": "stage",
            "allLabel": "All stages"
          }
        ],
        [
          {
            "title": "Deals by selected stage",
            "empty": "No deals match the selected stage.",
            "entity": "deal",
            "source": {
              "source": "recent",
              "filters": "{{stageFilter}}"
            },
            "titleFields": [
              "title",
              "deal_name"
            ],
            "metaFields": [
              "stage",
              "value",
              "closeBy"
            ]
          }
        ]
      ]
    },
    "crm.pipeline": {
      "title": "Pipeline",
      "subtitle": "Open deals and follow-up work",
      "controls": [
        {
          "kind": "selector",
          "key": "groupBy",
          "label": "Group by",
          "default": "stage",
          "allLabel": "Stage",
          "options": [
            {
              "value": "stage",
              "label": "Stage"
            },
            {
              "value": "owner",
              "label": "Owner"
            },
            {
              "value": "company",
              "label": "Company"
            }
          ]
        },
        {
          "kind": "selector",
          "key": "stage",
          "label": "Stage",
          "entity": "deal",
          "field": "stage",
          "allLabel": "All stages"
        }
      ],
      "stats": [
        {
          "label": "OPEN DEALS",
          "entity": "deal",
          "count": "open",
          "source": {
            "source": "recent-open",
            "filters": "stage != \"Won\" && stage != \"Lost\" && {{stageFilter}}"
          },
          "sub": {
            "entity": "deal",
            "count": "all",
            "suffix": "total"
          },
          "accent": "sky"
        },
        {
          "label": "WEIGHTED",
          "entity": "deal",
          "metric": "weightedForecast",
          "source": {
            "source": "recent-open",
            "filters": "stage != \"Won\" && stage != \"Lost\" && {{stageFilter}}"
          },
          "sub": "forecast on open",
          "accent": "mint"
        },
        {
          "label": "WON",
          "entity": "deal",
          "metric": "sum",
          "source": {
            "source": "recent",
            "filters": "stage == \"Won\" && {{stageFilter}}"
          },
          "field": "value",
          "sub": "won revenue",
          "accent": "emerald"
        },
        {
          "label": "LOST",
          "entity": "deal",
          "metric": "sum",
          "source": {
            "source": "recent",
            "filters": "stage == \"Lost\" && {{stageFilter}}"
          },
          "field": "value",
          "sub": "closed lost",
          "accent": "rose"
        },
        {
          "label": "WIN RATE",
          "entity": "deal",
          "metric": "winRate",
          "sub": "closed deals",
          "accent": "warn"
        }
      ],
      "layout": [
        [
          {
            "kind": "kanban",
            "entity": "deal",
            "source": {
              "source": "recent-open",
              "filters": "stage != \"Won\" && stage != \"Lost\" && {{stageFilter}}"
            },
            "groupBy": "stage"
          }
        ]
      ]
    },
    "reports.pipeline": {
      "kind": "report",
      "title": "Pipeline Report",
      "subtitle": "Deal flow, stage risk and owner balance",
      "controls": [
        {
          "kind": "selector",
          "key": "groupBy",
          "label": "Group by",
          "default": "stage",
          "allLabel": "Stage",
          "options": [
            {
              "value": "stage",
              "label": "Stage"
            },
            {
              "value": "owner",
              "label": "Owner"
            },
            {
              "value": "company",
              "label": "Company"
            }
          ]
        },
        {
          "kind": "selector",
          "key": "stage",
          "label": "Stage",
          "entity": "deal",
          "field": "stage",
          "allLabel": "All stages"
        },
        {
          "kind": "date-range",
          "key": "dateRange",
          "label": "Close date",
          "field": "expected_close",
          "allLabel": "All dates",
          "default": "this-quarter"
        }
      ],
      "stats": [
        {
          "label": "OPEN DEALS",
          "entity": "deal",
          "count": "open",
          "source": {
            "source": "recent-open",
            "filters": "stage != \"won\" && stage != \"lost\" && {{stageFilter}} && {{dateRangeFilter}}"
          },
          "sub": "open pipeline",
          "accent": "sky"
        },
        {
          "label": "WEIGHTED",
          "entity": "deal",
          "metric": "weightedForecast",
          "source": {
            "source": "recent-open",
            "filters": "stage != \"won\" && stage != \"lost\" && {{stageFilter}} && {{dateRangeFilter}}"
          },
          "sub": "forecast on open",
          "accent": "mint"
        },
        {
          "label": "WON",
          "entity": "deal",
          "metric": "sum",
          "source": {
            "source": "recent",
            "filters": "stage == \"won\" && {{stageFilter}} && {{dateRangeFilter}}"
          },
          "field": "deal_value",
          "sub": "won revenue",
          "accent": "emerald"
        },
        {
          "label": "LOST",
          "entity": "deal",
          "metric": "sum",
          "source": {
            "source": "recent",
            "filters": "stage == \"lost\" && {{stageFilter}} && {{dateRangeFilter}}"
          },
          "field": "deal_value",
          "sub": "closed lost",
          "accent": "rose"
        },
        {
          "label": "WIN RATE",
          "entity": "deal",
          "metric": "winRate",
          "source": {
            "source": "recent",
            "filters": "(stage == \"won\" || stage == \"lost\") && {{stageFilter}} && {{dateRangeFilter}}"
          },
          "sub": "closed deals",
          "accent": "warn"
        }
      ],
      "layout": [
        [
          {
            "kind": "bar-chart",
            "title": "OPEN VALUE BY STAGE",
            "entity": "deal",
            "source": {
              "source": "recent-open",
              "filters": "stage != \"won\" && stage != \"lost\" && {{stageFilter}} && {{dateRangeFilter}}"
            },
            "groupBy": "stage",
            "metric": "sum",
            "field": "deal_value",
            "limit": 6
          },
          {
            "kind": "bar-chart",
            "title": "OPEN DEALS BY OWNER",
            "entity": "deal",
            "source": {
              "source": "recent-open",
              "filters": "stage != \"won\" && stage != \"lost\" && {{stageFilter}} && {{dateRangeFilter}}"
            },
            "groupBy": "owner",
            "metric": "count",
            "limit": 10
          }
        ],
        [
          {
            "title": "STALE OR RISKY OPEN DEALS",
            "empty": "No risky open deals.",
            "entity": "deal",
            "source": {
              "source": "recent-open",
              "filters": "stage != \"won\" && stage != \"lost\" && {{stageFilter}} && {{dateRangeFilter}} && (date(expected_close) <= today() + 14d || date(last_contact) <= today() - 30d || next_action.isEmpty())",
              "sort": [
                {
                  "property": "expected_close",
                  "direction": "ASC"
                }
              ]
            },
            "titleFields": [
              "title",
              "deal_name"
            ],
            "metaFields": [
              "owner",
              "stage",
              "deal_value",
              "expected_close",
              "last_contact",
              "next_action"
            ],
            "limit": 8
          },
          {
            "title": "RECENT WINS",
            "empty": "No recent wins.",
            "entity": "deal",
            "source": {
              "source": "recent",
              "filters": "stage == \"won\" && {{stageFilter}} && {{dateRangeFilter}}",
              "sort": [
                {
                  "property": "deal_value",
                  "direction": "DESC"
                }
              ]
            },
            "titleFields": [
              "title",
              "deal_name"
            ],
            "metaFields": [
              "stage",
              "deal_value",
              "expected_close"
            ],
            "limit": 8
          }
        ],
        [
          {
            "kind": "markdown",
            "title": "PIPELINE NOTES",
            "subtitle": "How the report is calculated",
            "body": "## What this measures\n- Open pipeline excludes Won and Lost deals.\n- Weighted forecast uses the deal stage confidence table and `deal_value`.\n- Close-date filtering uses `expected_close`.\n- The risk list flags deals that are due soon, have not been contacted recently, or have no next action.\n\n## Notes\n- The stage selector narrows all pipeline widgets to the chosen stage.\n- Open pipeline review is still a note-level proxy until deals expose richer risk fields such as structured aging or last-activity rollups."
          }
        ]
      ]
    },
    "reports.sales": {
      "kind": "report",
      "title": "Sales Report",
      "subtitle": "Closed wins, losses and close timing",
      "controls": [
        {
          "kind": "selector",
          "key": "owner",
          "label": "Owner",
          "entity": "deal",
          "field": "owner",
          "allLabel": "All owners"
        },
        {
          "kind": "selector",
          "key": "source",
          "label": "Source",
          "entity": "deal",
          "field": "deal_source",
          "allLabel": "All sources"
        },
        {
          "kind": "selector",
          "key": "client",
          "label": "Client",
          "entity": "deal",
          "field": "client_id",
          "allLabel": "All clients"
        },
        {
          "kind": "date-range",
          "key": "dateRange",
          "label": "Close date",
          "field": "expected_close",
          "allLabel": "All dates",
          "default": "this-quarter"
        }
      ],
      "stats": [
        {
          "label": "REVENUE",
          "entity": "deal",
          "metric": "sum",
          "source": {
            "source": "recent",
            "filters": "stage == \"won\" && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}"
          },
          "field": "deal_value",
          "sub": "won deals",
          "accent": "emerald"
        },
        {
          "label": "LOST",
          "entity": "deal",
          "metric": "sum",
          "source": {
            "source": "recent",
            "filters": "stage == \"lost\" && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}"
          },
          "field": "deal_value",
          "sub": "closed lost",
          "accent": "rose"
        },
        {
          "label": "CAPTURE",
          "entity": "deal",
          "metric": "captureRate",
          "source": {
            "source": "recent",
            "filters": "(stage == \"won\" || stage == \"lost\") && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}"
          },
          "sub": "of closed value",
          "accent": "mint"
        },
        {
          "label": "AVG DEAL",
          "entity": "deal",
          "metric": "avg",
          "source": {
            "source": "recent",
            "filters": "stage == \"won\" && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}"
          },
          "field": "deal_value",
          "sub": "won deals",
          "accent": "sky"
        }
      ],
      "layout": [
        [
          {
            "kind": "bar-chart",
            "title": "WON REVENUE BY OWNER",
            "entity": "deal",
            "source": {
              "source": "recent",
              "filters": "stage == \"won\" && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}"
            },
            "groupBy": "owner",
            "metric": "sum",
            "field": "deal_value",
            "limit": 10
          },
          {
            "kind": "bar-chart",
            "title": "WON / LOST BY CLOSE DATE",
            "entity": "deal",
            "source": {
              "source": "recent",
              "filters": "(stage == \"won\" || stage == \"lost\") && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}"
            },
            "groupBy": "expected_close",
            "metric": "count",
            "limit": 12
          }
        ],
        [
          {
            "title": "LARGEST WON DEALS",
            "empty": "No won deals.",
            "entity": "deal",
            "source": {
              "source": "recent",
              "filters": "stage == \"won\" && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}",
              "sort": [
                {
                  "property": "deal_value",
                  "direction": "DESC"
                }
              ]
            },
            "titleFields": [
              "title",
              "deal_name"
            ],
            "metaFields": [
              "owner",
              "deal_value",
              "expected_close",
              "deal_source"
            ],
            "limit": 8
          },
          {
            "title": "LARGEST LOST DEALS",
            "empty": "No lost deals.",
            "entity": "deal",
            "source": {
              "source": "recent",
              "filters": "stage == \"lost\" && {{ownerFilter}} && {{sourceFilter}} && {{clientFilter}} && {{dateRangeFilter}}",
              "sort": [
                {
                  "property": "deal_value",
                  "direction": "DESC"
                }
              ]
            },
            "titleFields": [
              "title",
              "deal_name"
            ],
            "metaFields": [
              "owner",
              "deal_value",
              "expected_close",
              "deal_source"
            ],
            "limit": 8
          }
        ],
        [
          {
            "kind": "markdown",
            "title": "SALES NOTES",
            "subtitle": "How capture rate and timing are read",
            "body": "## What this measures\n- Revenue and lost value use the selected owner, source, client and close-date filters.\n- Capture rate is the won value divided by won plus lost value for the current filter set.\n- The close-date chart uses `expected_close` as the only available timing field, so it shows raw close dates until period buckets are materialized.\n\n## Notes\n- Source and client selectors are proxies for pipeline slicing until the deal schema carries richer account rollups."
          }
        ]
      ]
    },
    "reports.activity": {
      "kind": "report",
      "title": "Activity Report",
      "subtitle": "Calls, meetings and follow-ups",
      "controls": [
        {
          "kind": "date-range",
          "key": "dateRange",
          "label": "Date range",
          "field": "date",
          "allLabel": "All dates",
          "default": "this-month"
        },
        {
          "kind": "selector",
          "key": "channel",
          "label": "Channel",
          "entity": "activity",
          "field": "channel",
          "allLabel": "All channels"
        },
        {
          "kind": "selector",
          "key": "owner",
          "label": "Owner",
          "entity": "activity",
          "field": "owner",
          "allLabel": "All owners"
        }
      ],
      "stats": [
        {
          "label": "TOTAL",
          "entity": "activity",
          "count": "all",
          "source": {
            "source": "recent",
            "filters": "{{dateRangeFilter}} && {{channelFilter}}"
          },
          "sub": "all activities",
          "accent": "emerald"
        },
        {
          "label": "MEETINGS",
          "entity": "activity",
          "count": "all",
          "source": {
            "source": "recent",
            "filters": "channel == \"meeting\" && {{dateRangeFilter}} && {{channelFilter}}"
          },
          "sub": "meeting activities",
          "accent": "sky"
        },
        {
          "label": "CALLS + MSGS",
          "entity": "activity",
          "count": "all",
          "source": {
            "source": "recent",
            "filters": "(channel == \"call\" || channel == \"email\" || channel == \"telegram\" || channel == \"whatsapp\") && {{dateRangeFilter}} && {{channelFilter}}"
          },
          "sub": "calls and messages",
          "accent": "mint"
        },
        {
          "label": "FOLLOW UPS",
          "entity": "activity",
          "count": "all",
          "source": {
            "source": "recent",
            "filters": "date(next_action_date) <= today() && {{dateRangeFilter}} && {{channelFilter}}"
          },
          "sub": "overdue follow-ups",
          "accent": "warn"
        }
      ],
      "layout": [
        [
          {
            "kind": "bar-chart",
            "title": "ACTIVITY BY CHANNEL",
            "entity": "activity",
            "source": {
              "source": "recent",
              "filters": "{{dateRangeFilter}} && {{channelFilter}}",
              "sort": [
                {
                  "property": "date",
                  "direction": "DESC"
                }
              ]
            },
            "groupBy": "channel",
            "metric": "count",
            "limit": 8
          },
          {
            "kind": "bar-chart",
            "title": "ACTIVITY BY DIRECTION",
            "entity": "activity",
            "source": {
              "source": "recent",
              "filters": "{{dateRangeFilter}} && {{channelFilter}}",
              "sort": [
                {
                  "property": "date",
                  "direction": "DESC"
                }
              ]
            },
            "groupBy": "direction",
            "metric": "count",
            "limit": 6
          }
        ],
        [
          {
            "title": "RECENT ACTIVITIES",
            "empty": "No activities.",
            "entity": "activity",
            "source": {
              "source": "recent",
              "filters": "{{dateRangeFilter}} && {{channelFilter}}",
              "sort": [
                {
                  "property": "date",
                  "direction": "DESC"
                }
              ]
            },
            "titleFields": [
              "title",
              "subject",
              "name"
            ],
            "metaFields": [
              "channel",
              "direction",
              "date",
              "next_action_date"
            ],
            "limit": 10
          },
          {
            "title": "FOLLOW UPS NEEDED",
            "empty": "No overdue follow-ups.",
            "entity": "activity",
            "source": {
              "source": "recent",
              "filters": "date(next_action_date) <= today() && {{dateRangeFilter}} && {{channelFilter}}",
              "sort": [
                {
                  "property": "next_action_date",
                  "direction": "ASC"
                }
              ]
            },
            "titleFields": [
              "title",
              "subject",
              "name"
            ],
            "metaFields": [
              "channel",
              "direction",
              "date",
              "next_action_date"
            ],
            "limit": 10
          }
        ],
        [
          {
            "kind": "markdown",
            "title": "ACTIVITY NOTES",
            "subtitle": "How the activity counts are grouped",
            "body": "## What this measures\n- Meetings count channel = `meeting`.\n- Calls + messages count `call`, `email`, `telegram`, and `whatsapp`.\n- Follow-ups are activity notes whose `next_action_date` is due or overdue.\n- The channel selector narrows every widget on the report.\n\n## Notes\n- There is no owner field in the current activity fallback schema, so owner-based slicing is not enabled yet."
          }
        ]
      ]
    },
    "reports.productivity": {
      "kind": "report",
      "title": "Productivity",
      "subtitle": "Backlog health and 30-day flow",
      "stats": [
        {
          "label": "BACKLOG",
          "entity": "task",
          "field": "backlogOpen",
          "source": {
            "mode": "built-in",
            "builtIn": "productivity"
          },
          "sub": "open tasks, all time",
          "accent": "sky"
        },
        {
          "label": "CREATED",
          "entity": "task",
          "field": "createdInWindow",
          "source": {
            "mode": "built-in",
            "builtIn": "productivity"
          },
          "sub": "new in last 30d",
          "accent": "rose"
        },
        {
          "label": "CLOSED",
          "entity": "task",
          "field": "closedInWindow",
          "source": {
            "mode": "built-in",
            "builtIn": "productivity"
          },
          "sub": "closed in last 30d",
          "accent": "emerald"
        },
        {
          "label": "NET",
          "entity": "task",
          "field": "netBacklogChange",
          "source": {
            "mode": "built-in",
            "builtIn": "productivity"
          },
          "sub": "backlog change, 30d",
          "accent": "warn"
        },
        {
          "label": "OVERDUE",
          "entity": "task",
          "field": "backlogOverdue",
          "source": {
            "mode": "built-in",
            "builtIn": "productivity"
          },
          "sub": "past due or scheduled",
          "accent": "rose"
        },
        {
          "label": "STALE",
          "entity": "task",
          "field": "backlogStale",
          "source": {
            "mode": "built-in",
            "builtIn": "productivity"
          },
          "sub": "open, older than 30d",
          "accent": "warn"
        }
      ],
      "layout": [
        [
          {
            "kind": "gauge",
            "title": "BURN-DOWN RATE",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity"
            },
            "field": "burnRate",
            "max": 200,
            "suffix": "%",
            "caption": "closed vs created",
            "sub": "Tasks closed divided by tasks created over the last 30 days. Above 100% the backlog is shrinking."
          },
          {
            "kind": "bar-chart",
            "title": "CREATED PER WEEK — LAST 12 WEEKS",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "weeks"
            },
            "field": "created",
            "limit": 12
          }
        ],
        [
          {
            "kind": "heatmap",
            "title": "CONTENT CADENCE",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "per-day"
            },
            "dateField": "date",
            "field": "journal",
            "days": 35,
            "columns": 7,
            "empty": "No daily note activity yet."
          },
          {
            "kind": "bar-chart",
            "title": "CLOSED PER WEEK — LAST 12 WEEKS",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "weeks"
            },
            "field": "closed",
            "limit": 12
          }
        ],
        [
          {
            "kind": "bar-chart",
            "title": "TASKS BY PROJECT",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "projects"
            },
            "field": "value",
            "limit": 8
          },
          {
            "kind": "bar-chart",
            "title": "TASKS BY CONTEXT",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "contexts"
            },
            "field": "value",
            "limit": 8
          }
        ],
        [
          {
            "kind": "list",
            "title": "OVERDUE TASKS",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "overdue-open"
            },
            "limit": 10,
            "empty": "No overdue open tasks."
          },
          {
            "kind": "list",
            "title": "HIGH PRIORITY TASKS",
            "source": {
              "mode": "built-in",
              "builtIn": "productivity",
              "section": "high-priority"
            },
            "limit": 10,
            "empty": "No high-priority open tasks."
          }
        ],
        [
          {
            "kind": "markdown",
            "title": "PRODUCTIVITY NOTES",
            "subtitle": "How backlog and flow are separated",
            "body": "## What this measures\n- BACKLOG, OVERDUE and STALE are point-in-time totals over every TaskNote, with no date window applied.\n- CREATED, CLOSED and NET cover the last 30 days only. NET is created minus closed, so a positive number means the backlog grew.\n- BURN-DOWN RATE is closed divided by created over the same 30 days. Above 100% you are closing faster than you add.\n- The heatmap and the project/context splits remain windowed views of recent activity, not backlog totals.\n\n## Notes\n- A task with no explicit created date falls back to file creation time; a closed task with no completion date falls back to last-modified.\n- Cancelled tasks are excluded everywhere."
          }
        ]
      ]
    }
  },
